<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>GastroArt Yönetim</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdn.jsdelivr.net/npm/remixicon@3.5.0/fonts/remixicon.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Outfit', sans-serif;
            background: #f8f9fa;
        }
        .no-scrollbar::-webkit-scrollbar {
            display: none;
        }

        .no-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }
    </style>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<audio id="bell-sound" src="https://cdn.freesound.org/previews/339/339816_5121236-lq.mp3" preload="auto"></audio>

<div id="notification-container" class="fixed top-5 right-5 z-[9999] space-y-3"></div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>

<script>
    // 1. Bağlantı
    const adminConnection = new signalR.HubConnectionBuilder()
        .withUrl("/orderHub")
        .build();

    adminConnection.start().then(() => console.log("🔔 Admin Bildirim Hattı Açık")).catch(err => console.error(err));

    // 2. "ReceiveWaiterCall" Sinyalini Dinle
    adminConnection.on("ReceiveWaiterCall", function (tableNo) {

        // Sesi Çal
        const audio = document.getElementById("bell-sound");
        audio.play().catch(e => console.log("Ses izni yok"));

        // Bildirim Kutusunu Oluştur
        createNotification(tableNo);
    });

    function createNotification(tableNo) {
        const container = document.getElementById('notification-container');

        const notif = document.createElement('div');
        notif.className = "bg-white border-l-4 border-orange-500 shadow-2xl p-4 rounded-r-xl flex items-center gap-4 min-w-[300px] transform transition-all duration-500 translate-x-full";

        notif.innerHTML = `
            <div class="bg-orange-100 p-3 rounded-full text-orange-600">
                <i class="ri-notification-3-fill text-xl"></i>
            </div>
            <div class="flex-1">
                <h4 class="font-bold text-gray-800 text-sm">GARSON ÇAĞRISI</h4>
                <p class="text-xs text-gray-500">Masa <b class="text-lg text-black">${tableNo}</b> yardım istiyor.</p>
            </div>
            <button onclick="this.parentElement.remove()" class="text-gray-300 hover:text-black"><i class="ri-close-line"></i></button>
        `;

        container.appendChild(notif);

        // Kayarak Gelme Efekti
        setTimeout(() => notif.classList.remove('translate-x-full'), 100);

        // 10 Saniye sonra otomatik kaybolsun
        setTimeout(() => {
            notif.classList.add('translate-x-full', 'opacity-0');
            setTimeout(() => notif.remove(), 500);
        }, 10000);
    }
</script>
<div id="ai-fab" onclick="toggleAiChat()"
     class="fixed bottom-6 right-24 bg-gradient-to-r from-indigo-600 to-blue-600 text-white w-14 h-14 rounded-full flex items-center justify-center shadow-2xl cursor-pointer transition-transform hover:scale-110 z-[999] border-2 border-white">
    <i class="ri-robot-2-line text-2xl"></i>
</div>

<div id="ai-chat-window" class="fixed bottom-24 right-6 w-80 md:w-96 h-[500px] bg-white rounded-3xl shadow-2xl z-[999] hidden flex-col overflow-hidden border border-gray-100 transform transition-all duration-300 origin-bottom-right scale-95 opacity-0">

    <div class="bg-gradient-to-r from-indigo-600 to-blue-600 p-4 flex justify-between items-center cursor-pointer" ondblclick="toggleExpand()">
        <div class="flex items-center gap-3">
            <div class="w-8 h-8 bg-white/20 rounded-full flex items-center justify-center text-white">
                <i class="ri-sparkling-fill"></i>
            </div>
            <div>
                <h4 class="font-bold text-white text-sm">GastroAI</h4>
                <p class="text-indigo-100 text-[10px]">Akıllı Asistan</p>
            </div>
        </div>

        <div class="flex items-center gap-1">
            <button onclick="toggleExpand()" class="text-white hover:bg-white/20 rounded-full p-1.5 transition" title="Genişlet/Küçült">
                <i id="ai-expand-icon" class="ri-fullscreen-line text-lg"></i>
            </button>

            <button onclick="toggleAiChat()" class="text-white hover:bg-white/20 rounded-full p-1.5 transition" title="Kapat">
                <i class="ri-close-line text-xl"></i>
            </button>
        </div>
    </div>

    <div id="ai-messages" class="flex-1 overflow-y-auto p-4 space-y-3 bg-gray-50 scroll-smooth">
        <div class="flex gap-2 items-end">
            <div class="w-6 h-6 bg-indigo-100 rounded-full flex items-center justify-center text-indigo-600 text-xs flex-shrink-0"><i class="ri-robot-2-fill"></i></div>
            <div class="bg-white p-3 rounded-2xl rounded-bl-none shadow-sm text-xs text-gray-600 border border-gray-100 leading-relaxed">
                Merhaba Yönetici! 👋<br>Restoranın durumu, stoklar veya satış stratejileri hakkında bana her şeyi sorabilirsin.
            </div>
        </div>
    </div>

    <div class="p-3 bg-white border-t border-gray-100 flex gap-2">
        <input type="text" id="ai-input" placeholder="Bir soru sor..." class="flex-1 bg-gray-50 border border-gray-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-indigo-500 transition" onkeypress="if(event.key==='Enter') sendToAi()">
        <button onclick="sendToAi()" class="bg-indigo-600 text-white w-12 rounded-xl flex items-center justify-center hover:bg-indigo-700 transition shadow-md active:scale-95">
            <i class="ri-send-plane-fill text-lg"></i>
        </button>
    </div>
</div>

<script>
    const aiWindow = document.getElementById('ai-chat-window');
    const aiMsgs = document.getElementById('ai-messages');
    const aiInput = document.getElementById('ai-input');
    const expandIcon = document.getElementById('ai-expand-icon');
    let isExpanded = false;

    // AÇ / KAPA
    function toggleAiChat() {
        if (aiWindow.classList.contains('hidden')) {
            aiWindow.classList.remove('hidden');
            setTimeout(() => {
                aiWindow.classList.remove('scale-95', 'opacity-0');
                aiInput.focus();
            }, 10);
        } else {
            aiWindow.classList.add('scale-95', 'opacity-0');
            setTimeout(() => aiWindow.classList.add('hidden'), 200);
        }
    }

    // GENİŞLET / KÜÇÜLT (YENİ FONKSİYON)
    function toggleExpand() {
        isExpanded = !isExpanded;

        if (isExpanded) {
            // Geniş Mod
            aiWindow.classList.remove('w-80', 'md:w-96', 'h-[500px]'); // Eski boyutları sil
            aiWindow.classList.add('w-[95vw]', 'h-[85vh]', 'md:w-[800px]', 'md:h-[700px]'); // Yeni dev boyutlar
            expandIcon.classList.replace('ri-fullscreen-line', 'ri-fullscreen-exit-line'); // İkonu değiştir
        } else {
            // Normal Mod
            aiWindow.classList.add('w-80', 'md:w-96', 'h-[500px]'); // Eski boyutları ekle
            aiWindow.classList.remove('w-[95vw]', 'h-[85vh]', 'md:w-[800px]', 'md:h-[700px]'); // Dev boyutları sil
            expandIcon.classList.replace('ri-fullscreen-exit-line', 'ri-fullscreen-line'); // İkonu değiştir
        }
    }

    async function sendToAi() {
        const text = aiInput.value.trim();
        if (!text) return;

        addMessage(text, 'user');
        aiInput.value = '';
        const loadingId = addMessage('Analiz ediliyor...', 'ai', true);

        try {
            const response = await fetch('/Ai/AskAi', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ message: text })
            });
            const data = await response.json();

            removeMessage(loadingId);

            if (data.answer) {
                addMessage(data.answer, 'ai');
            } else {
                addMessage("Bir hata oluştu: " + (data.error || "Bilinmeyen hata"), 'ai');
            }
        } catch (error) {
            removeMessage(loadingId);
            addMessage("Bağlantı hatası.", 'ai');
        }
    }

    function addMessage(text, sender, isLoading = false) {
        const id = 'msg-' + Date.now();
        const isUser = sender === 'user';

        let formattedText = text.replace(/\*\*(.*?)\*\*/g, '<b>$1</b>');
        formattedText = formattedText.replace(/\n/g, '<br>');

        const html = `
        <div id="${id}" class="flex gap-2 items-end ${isUser ? 'flex-row-reverse' : ''} animate-fade-in-up">
            <div class="w-6 h-6 ${isUser ? 'bg-black' : 'bg-indigo-100 text-indigo-600'} rounded-full flex items-center justify-center text-xs flex-shrink-0">
                <i class="${isUser ? 'ri-user-fill text-white' : 'ri-robot-2-fill'}"></i>
            </div>
            <div class="${isUser ? 'bg-black text-white' : 'bg-white text-gray-700 border border-gray-100'} p-3 rounded-2xl ${isUser ? 'rounded-br-none' : 'rounded-bl-none'} shadow-sm text-xs leading-relaxed max-w-[85%]">
                ${isLoading ? '<i class="ri-loader-4-line animate-spin inline-block mr-1"></i> ' : ''}
                ${formattedText}
            </div>
        </div>`;

        aiMsgs.insertAdjacentHTML('beforeend', html);
        aiMsgs.scrollTo({ top: aiMsgs.scrollHeight, behavior: 'smooth' });
        return id;
    }

    function removeMessage(id) {
        const el = document.getElementById(id);
        if (el) el.remove();
    }
</script>

<style>
    keyframes fadeInUp {
        from

    {
        opacity: 0;
        transform: translateY(10px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    .animate-fade-in-up {
        animation: fadeInUp 0.3s ease-out forwards;
    }
</style>
<body class="flex h-screen overflow-hidden bg-[#f8f9fa]">

    <div id="mobile-overlay" onclick="toggleSidebar()" class="fixed inset-0 bg-black/50 z-40 hidden md:hidden backdrop-blur-sm transition-opacity"></div>

    <aside id="sidebar" class="fixed inset-y-0 left-0 z-50 w-64 bg-white border-r border-gray-200 transform -translate-x-full md:relative md:translate-x-0 transition-transform duration-300 ease-in-out flex flex-col h-full shadow-2xl md:shadow-none">

        <div class="p-6 border-b border-gray-100 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="w-8 h-8 bg-black rounded-lg flex items-center justify-center text-white font-bold">G</div>
                <span class="text-xl font-bold tracking-wider text-gray-800">GASTROART</span>
            </div>
            <button onclick="toggleSidebar()" class="md:hidden text-gray-400 hover:text-red-500">
                <i class="ri-close-line text-2xl"></i>
            </button>
        </div>

        <div class="flex-1 overflow-y-auto no-scrollbar">
            @await Component.InvokeAsync("AdminSidebar")
        </div>
    </aside>

    <main class="flex-1 flex flex-col h-full relative overflow-hidden w-full">

        <header class="h-16 bg-white/80 backdrop-blur-md border-b border-gray-200 flex md:hidden items-center justify-between px-4 sticky top-0 z-30">
            <div class="flex items-center gap-3">
                <button onclick="toggleSidebar()" class="p-2 -ml-2 text-gray-700 rounded-lg hover:bg-gray-100">
                    <i class="ri-menu-2-line text-2xl"></i>
                </button>
                <span class="font-bold text-lg text-gray-800">Yönetim Paneli</span>
            </div>
            <div class="w-8 h-8 bg-gray-200 rounded-full flex items-center justify-center text-xs font-bold">A</div>
        </header>

        <div class="flex-1 overflow-y-auto p-4 md:p-8 pb-24">
            @RenderBody()
        </div>

    </main>

    <script>
        function toggleSidebar() {
            const sidebar = document.getElementById('sidebar');
            const overlay = document.getElementById('mobile-overlay');

            if (sidebar.classList.contains('-translate-x-full')) {
                sidebar.classList.remove('-translate-x-full');
                overlay.classList.remove('hidden');
            } else {
                sidebar.classList.add('-translate-x-full');
                overlay.classList.add('hidden');
            }
        }
    </script>

</body>
</html>