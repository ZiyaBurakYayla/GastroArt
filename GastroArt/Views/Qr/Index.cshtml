@{
    ViewData["Title"] = "QR Kod Oluştur";
    Layout = "_AdminLayout";
}

<div class="mb-8">
    <h1 class="text-2xl font-bold text-gray-900">QR Kod Oluşturucu</h1>
    <p class="text-sm text-gray-500">Masalarınız için otomatik QR menü etiketleri oluşturun.</p>
</div>

<div class="bg-white p-8 rounded-3xl border border-gray-100 shadow-sm max-w-lg">
    <form action="/Qr/Generate" method="post">
        <div class="grid grid-cols-2 gap-6 mb-6">
            <div>
                <label class="block text-xs font-bold text-gray-400 uppercase mb-2">Başlangıç Masa No</label>
                <input type="number" name="startTable" value="1" min="1" class="w-full p-4 rounded-xl bg-gray-50 border border-gray-200 outline-none focus:border-black font-bold text-center text-lg">
            </div>
            <div>
                <label class="block text-xs font-bold text-gray-400 uppercase mb-2">Bitiş Masa No</label>
                <input type="number" name="endTable" value="10" min="1" class="w-full p-4 rounded-xl bg-gray-50 border border-gray-200 outline-none focus:border-black font-bold text-center text-lg">
            </div>
        </div>

        <div class="bg-blue-50 p-4 rounded-xl border border-blue-100 mb-6 flex items-start gap-3">
            <i class="ri-information-line text-blue-500 text-xl"></i>
            <p class="text-xs text-blue-700 leading-relaxed">
                "Oluştur" dediğinizde yazdırma sayfasına yönlendirileceksiniz. Bu QR kodlar, müşteriyi doğrudan ilgili masa numarasıyla menüye sokar.
            </p>
        </div>

        <button type="submit" class="w-full py-4 bg-black text-white rounded-xl font-bold text-lg hover:bg-gray-800 transition shadow-lg flex items-center justify-center gap-2">
            <i class="ri-qr-code-line"></i> KODLARI OLUŞTUR
        </button>
    </form>
</div>