@model List<GastroArt.Models.Entity.Category>
@{
    ViewData["Title"] = "Yeni Sipariş";
    Layout = "_AdminLayout";
}

<div class="flex flex-col md:flex-row h-full md:h-[calc(100vh-100px)] gap-6 pb-20 md:pb-0">

    <div class="flex-1 flex flex-col overflow-hidden h-full">

        <div class="flex gap-2 overflow-x-auto pb-4 no-scrollbar px-1 sticky top-0 bg-[#f8f9fa] z-10">
            <button onclick="filterCategory('all')" class="px-4 py-2 bg-black text-white rounded-xl text-sm font-bold whitespace-nowrap hover:bg-gray-800 transition cat-btn active shadow-sm" id="btn-all">Tümü</button>
            @foreach (var cat in Model)
            {
                <button onclick="filterCategory('@cat.Id')" class="px-4 py-2 bg-white border border-gray-200 text-gray-600 rounded-xl text-sm font-bold whitespace-nowrap hover:bg-gray-50 transition cat-btn shadow-sm" id="btn-@cat.Id">
                    @cat.Name
                </button>
            }
        </div>

        <div class="flex-1 overflow-y-auto pr-2">
            <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 pb-24 md:pb-0">
                @foreach (var cat in Model)
                {
                    @foreach (var p in cat.Products)
                    {
                        if (p.IsActive)
                        {
                            <div class="bg-white p-3 rounded-2xl border border-gray-100 shadow-sm cursor-pointer hover:border-black transition product-item group active:scale-95"
                                 data-cat="@cat.Id"
                                 onclick="addToCart('@p.Name', @p.Price.ToString(System.Globalization.CultureInfo.InvariantCulture))">

                                <div class="aspect-square rounded-xl overflow-hidden mb-2 bg-gray-50 relative">
                                    <img src="@(p.ImageUrl ?? "https://via.placeholder.com/150")" class="w-full h-full object-cover group-hover:scale-110 transition duration-500">
                                    <div class="absolute bottom-1 right-1 bg-white rounded-full w-6 h-6 flex items-center justify-center shadow-sm">
                                        <i class="ri-add-line text-xs font-bold"></i>
                                    </div>
                                </div>
                                <h4 class="font-bold text-gray-800 text-xs md:text-sm line-clamp-1">@p.Name</h4>
                                <div class="text-green-600 font-bold text-xs md:text-sm">@p.Price.ToString("N2")₺</div>
                            </div>
                        }
                    }
                }
            </div>
        </div>
    </div>

    <div id="desktop-cart" class="hidden md:flex w-96 bg-white rounded-3xl shadow-xl border border-gray-100 flex-col overflow-hidden">
        <div class="p-5 border-b border-gray-100 bg-gray-50">
            <h3 class="font-bold text-lg text-gray-800 flex items-center gap-2"><i class="ri-shopping-basket-2-line"></i> Yeni Adisyon</h3>
        </div>
        <div id="pos-cart-items-desktop" class="flex-1 overflow-y-auto p-4 space-y-3"></div>
        <div class="p-5 bg-gray-50 border-t border-gray-100">
            <div class="flex justify-between items-center mb-4">
                <span class="text-gray-500 font-bold text-sm uppercase">Toplam</span>
                <span id="pos-total-desktop" class="text-2xl font-black text-gray-900">0.00₺</span>
            </div>
            <div class="space-y-3">
                <input type="text" id="pos-table-d" placeholder="Masa No" class="w-full p-3 rounded-xl border border-gray-200 text-sm focus:border-black outline-none font-bold">
                <input type="text" id="pos-note-d" placeholder="Not" class="w-full p-3 rounded-xl border border-gray-200 text-sm focus:border-black outline-none">
                <button onclick="submitPosOrder('d')" class="w-full py-4 bg-black text-white rounded-xl font-bold hover:bg-gray-800 transition shadow-lg active:scale-95">SİPARİŞİ OLUŞTUR</button>
            </div>
        </div>
    </div>

</div>

<div id="mobile-cart-bar" onclick="toggleMobileCart()" class="md:hidden fixed bottom-0 left-0 w-full bg-black text-white p-4 rounded-t-2xl shadow-[0_-5px_20px_rgba(0,0,0,0.2)] z-50 flex justify-between items-center cursor-pointer transform translate-y-full transition-transform duration-300">
    <div class="flex items-center gap-3">
        <div class="w-10 h-10 bg-white/20 rounded-full flex items-center justify-center font-bold text-lg" id="mobile-cart-count">0</div>
        <div class="flex flex-col">
            <span class="text-xs text-gray-300 font-medium">Sepet Toplamı</span>
            <span class="text-lg font-bold" id="mobile-cart-total-preview">0.00₺</span>
        </div>
    </div>
    <div class="flex items-center gap-2 font-bold text-sm">
        Sepeti Gör <i class="ri-arrow-up-s-line"></i>
    </div>
</div>

<div id="mobile-cart-modal" class="md:hidden fixed inset-0 z-[60] hidden bg-gray-50 flex flex-col transform translate-y-full transition-transform duration-300">
    <div class="p-4 bg-white shadow-sm flex justify-between items-center">
        <h3 class="font-bold text-lg">Sepetim</h3>
        <button onclick="toggleMobileCart()" class="p-2 bg-gray-100 rounded-full"><i class="ri-close-line text-xl"></i></button>
    </div>

    <div id="pos-cart-items-mobile" class="flex-1 overflow-y-auto p-4 space-y-3 pb-20"></div>

    <div class="p-4 bg-white border-t border-gray-100">
        <div class="flex justify-between items-center mb-4">
            <span class="text-gray-500 font-bold text-sm">Toplam Tutar</span>
            <span id="pos-total-mobile" class="text-2xl font-black text-gray-900">0.00₺</span>
        </div>
        <div class="space-y-3">
            <input type="text" id="pos-table-m" placeholder="Masa No" class="w-full p-3 rounded-xl border border-gray-200 bg-gray-50 text-sm focus:border-black outline-none font-bold">
            <input type="text" id="pos-note-m" placeholder="Sipariş Notu" class="w-full p-3 rounded-xl border border-gray-200 bg-gray-50 text-sm focus:border-black outline-none">
            <button onclick="submitPosOrder('m')" class="w-full py-4 bg-black text-white rounded-xl font-bold text-lg shadow-lg active:scale-95">ONAYLA</button>
        </div>
    </div>
</div>

<script>
    let cart = [];

    function filterCategory(catId) {
        document.querySelectorAll('.cat-btn').forEach(b => {
            b.classList.remove('bg-black', 'text-white');
            b.classList.add('bg-white', 'text-gray-600', 'border');
        });
        document.getElementById('btn-' + catId).classList.remove('bg-white', 'text-gray-600', 'border');
        document.getElementById('btn-' + catId).classList.add('bg-black', 'text-white');

        const products = document.querySelectorAll('.product-item');
        products.forEach(p => {
            if (catId === 'all' || p.getAttribute('data-cat') === catId) p.style.display = 'block';
            else p.style.display = 'none';
        });
    }

    function addToCart(name, price) {
        let existing = cart.find(x => x.name === name);
        if(existing) existing.qty++;
        else cart.push({ name: name, price: parseFloat(price), qty: 1 });
        renderAllCarts();
    }

    function updateQty(index, delta) {
        cart[index].qty += delta;
        if(cart[index].qty <= 0) cart.splice(index, 1);
        renderAllCarts();
    }

    // Hem Masaüstü Hem Mobil Sepeti Güncelle
    function renderAllCarts() {
        renderCart('desktop'); // Masaüstü görünümü
        renderCart('mobile');  // Mobil görünümü
        updateMobileBar();     // Alt barı güncelle
    }

    function renderCart(type) {
        const suffix = type === 'desktop' ? '-desktop' : '-mobile'; // ID son eki
        const list = document.getElementById('pos-cart-items' + suffix);
        const totalEl = document.getElementById('pos-total' + suffix);

        if(cart.length === 0) {
            list.innerHTML = '<div class="text-center text-gray-400 mt-10 text-sm">Sepet boş.</div>';
            totalEl.innerText = '0.00₺';
            return;
        }

        list.innerHTML = '';
        let total = 0;

        cart.forEach((item, i) => {
            total += item.price * item.qty;
            list.innerHTML += `
            <div class="flex justify-between items-center bg-white p-3 rounded-xl border border-gray-100 shadow-sm">
                <div>
                    <div class="font-bold text-sm text-gray-800">${item.name}</div>
                    <div class="text-xs text-gray-500">${item.price}₺ x ${item.qty}</div>
                </div>
                <div class="flex items-center gap-2">
                    <button onclick="updateQty(${i}, -1)" class="w-7 h-7 bg-gray-100 rounded-lg hover:bg-gray-200 font-bold">-</button>
                    <span class="text-sm font-bold w-4 text-center">${item.qty}</span>
                    <button onclick="updateQty(${i}, 1)" class="w-7 h-7 bg-black text-white rounded-lg hover:bg-gray-800 font-bold">+</button>
                </div>
            </div>`;
        });

        totalEl.innerText = total.toFixed(2) + '₺';
    }

    // Mobil Alt Bar Mantığı
    function updateMobileBar() {
        const bar = document.getElementById('mobile-cart-bar');
        const count = document.getElementById('mobile-cart-count');
        const totalPrev = document.getElementById('mobile-cart-total-preview');

        let totalQty = cart.reduce((a,b)=>a+b.qty,0);
        let totalPrice = cart.reduce((a,b)=>a+(b.price*b.qty),0);

        count.innerText = totalQty;
        totalPrev.innerText = totalPrice.toFixed(2) + '₺';

        if(totalQty > 0) bar.classList.remove('translate-y-full'); // Göster
        else {
            bar.classList.add('translate-y-full'); // Gizle
            // Sepet boşaldıysa modalı da kapat
            document.getElementById('mobile-cart-modal').classList.add('translate-y-full');
            document.getElementById('mobile-cart-modal').classList.add('hidden');
        }
    }

    // Mobil Sepeti Aç/Kapa
    function toggleMobileCart() {
        const modal = document.getElementById('mobile-cart-modal');

        if (modal.classList.contains('hidden')) {
            modal.classList.remove('hidden');
            setTimeout(() => modal.classList.remove('translate-y-full'), 10);
        } else {
            modal.classList.add('translate-y-full');
            setTimeout(() => modal.classList.add('hidden'), 300);
        }
    }

    function submitPosOrder(type) {
        const suffix = type === 'd' ? '-d' : '-m'; // Masaüstü (-d) veya Mobil (-m) inputları
        const table = document.getElementById('pos-table' + suffix).value;
        const note = document.getElementById('pos-note' + suffix).value;

        if(!table) { alert('Lütfen Masa No giriniz!'); return; }
        if(cart.length === 0) { alert('Sepet boş!'); return; }

        const orderData = {
            TableNo: table,
            CustomerNote: note,
            Items: cart.map(i => ({ Name: i.name, Price: i.price, Quantity: i.qty }))
        };

        fetch('/Order/PlaceAdminOrder', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(orderData)
        })
        .then(res => res.json())
        .then(data => {
            if(data.success) {
                alert('✅ Sipariş Oluşturuldu!');
                cart = [];
                renderAllCarts();
                document.getElementById('pos-table' + suffix).value = '';
                document.getElementById('pos-note' + suffix).value = '';
                if(type === 'm') toggleMobileCart(); // Mobildeyse modalı kapat
            } else {
                alert('❌ Hata: ' + data.message);
            }
        });
    }
</script>